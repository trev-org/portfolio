{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rovert.io/schemas/wrapped.schema.json",
  "title": "Portfolio Wrapped data",
  "description": "Versioned travel and step totals for one calendar year.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "year",
    "example",
    "updatedThrough",
    "cities",
    "flights",
    "driving",
    "steps"
  ],
  "properties": {
    "$schema": {
      "const": "./wrapped.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "example": {
      "type": "boolean"
    },
    "updatedThrough": {
      "$ref": "#/$defs/date"
    },
    "cities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/city"
      }
    },
    "flights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "totalMiles"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flight"
          }
        },
        "totalMiles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "driving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example",
        "monthlyMiles"
      ],
      "properties": {
        "example": {
          "type": "boolean"
        },
        "monthlyMiles": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/drivingMonth"
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example",
        "monthly",
        "yearlyTotal",
        "updatedThrough",
        "daysTracked",
        "dailyAverage",
        "bestDay"
      ],
      "properties": {
        "example": {
          "type": "boolean"
        },
        "monthly": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/stepsMonth"
          }
        },
        "yearlyTotal": {
          "type": "integer",
          "minimum": 0
        },
        "updatedThrough": {
          "$ref": "#/$defs/date"
        },
        "daysTracked": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "dailyAverage": {
          "type": "integer",
          "minimum": 0
        },
        "bestDay": {
          "$ref": "#/$defs/stepsBestDay"
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city",
        "regionCountry",
        "lat",
        "lng",
        "source"
      ],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "regionCountry": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "source": {
          "enum": [
            "curated",
            "timeline"
          ]
        },
        "firstVisited": {
          "$ref": "#/$defs/date"
        },
        "dates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dateRange"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "firstVisited"
          ]
        },
        {
          "required": [
            "dates"
          ]
        }
      ]
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "flight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "endDate",
        "from",
        "to",
        "miles"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "miles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "drivingMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "miles"
      ],
      "properties": {
        "month": {
          "$ref": "#/$defs/month"
        },
        "miles": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stepsMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "total",
        "sourceMix"
      ],
      "properties": {
        "month": {
          "$ref": "#/$defs/month"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "sourceMix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stepsBestDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "steps"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
